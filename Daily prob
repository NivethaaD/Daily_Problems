1. Calculate Digit Sum of a String

class Solution:
    def sumofDigits(self, group):
      sum = 0
      for digi in group:
        sum = sum + (ord(digi) - ord('0'))

      return str(sum)

    def splitGroups(self, s, k):
      while len(s) > k:
        n = len(s)
        ans = ""

        for i in range(0, n, k):
          group = s[i:i+k]
          ans = ans + self.sumofDigits(group)
        s = ans
      return s
      
    def digitSum(self, s: str, k: int) -> str:
        return self.splitGroups(s,k)

2. Product of the Last K Numbers

class ProductOfNumbers:

    def __init__(self):
        self.prefix = [1]

    def add(self, num: int) -> None:
        if num == 0:
            self.prefix = [1]
        else:
            if len(self.prefix):
                self.prefix.append(self.prefix[-1]*num)
            else:
                self.prefix.append(num)

    def getProduct(self, k: int) -> int:
        n = len(self.prefix)
        if k >= n:
            return 0
        return self.prefix[n-1] // self.prefix[n-k-1]

3. Maximum Subarray With Equal Products

import math

class Solution:
    def prodEquivalent(self, start, end, nums):
        temp = nums[start:end+1]
        prodVal = math.prod(temp)
        gcdVal = math.gcd(*temp)
        lcmVal = math.lcm(*temp)
        if prodVal == lcmVal*gcdVal:
            return True
        
        return False
            

    def maxLength(self, nums: List[int]) -> int:
        maxi = 0

        for i in range(0,len(nums)):
            for j in range(i,len(nums)):
                prodEqual = self.prodEquivalent(i,j,nums)
                if prodEqual and len(nums[i:j+1]) > maxi:
                    maxi = len(nums[i:j+1])

        return maxi
                

