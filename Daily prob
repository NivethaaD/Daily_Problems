1. Calculate Digit Sum of a String

class Solution:
    def sumofDigits(self, group):
      sum = 0
      for digi in group:
        sum = sum + (ord(digi) - ord('0'))

      return str(sum)

    def splitGroups(self, s, k):
      while len(s) > k:
        n = len(s)
        ans = ""

        for i in range(0, n, k):
          group = s[i:i+k]
          ans = ans + self.sumofDigits(group)
        s = ans
      return s
      
    def digitSum(self, s: str, k: int) -> str:
        return self.splitGroups(s,k)

2. Product of the Last K Numbers

class ProductOfNumbers:

    def __init__(self):
        self.prefix = [1]

    def add(self, num: int) -> None:
        if num == 0:
            self.prefix = [1]
        else:
            if len(self.prefix):
                self.prefix.append(self.prefix[-1]*num)
            else:
                self.prefix.append(num)

    def getProduct(self, k: int) -> int:
        n = len(self.prefix)
        if k >= n:
            return 0
        return self.prefix[n-1] // self.prefix[n-k-1]


